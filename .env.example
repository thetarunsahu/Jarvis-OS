# ------------------------------------------------------------
# JARVIS model routing
# JARVIS_PROVIDER=auto lets the router choose a provider.
# routing mode: local_first | balanced | cloud_first
# ------------------------------------------------------------
JARVIS_PROVIDER=auto
JARVIS_ROUTING_MODE=local_first

# ------------------------------------------------------------
# Local AI — Ollama
# ------------------------------------------------------------
OLLAMA_MODEL=qwen3:8b

# Optional local embeddings for semantic file retrieval.
# Pull the model first, then enable semantic search.
OLLAMA_EMBEDDING_MODEL=embeddinggemma
JARVIS_SEMANTIC_SEARCH_ENABLED=false

# ------------------------------------------------------------
# Local AI — LM Studio
# Enable only when the LM Studio local server is running.
# ------------------------------------------------------------
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
# LMSTUDIO_API_KEY=lm-studio

# ------------------------------------------------------------
# Cloud AI — OpenAI
# Custom JARVIS tools use the Responses API function-calling loop.
# Hosted web research is opt-in because it can incur API cost.
# ------------------------------------------------------------
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6
OPENAI_MAX_TOOL_ROUNDS=8
OPENAI_WEB_RESEARCH_ENABLED=false
OPENAI_RESEARCH_MODEL=gpt-5.6

# ------------------------------------------------------------
# Desktop Voice
# TTS is offline when pyttsx3/system speech is available.
# Current first-pass STT uses Google's recognizer after local recording.
# ------------------------------------------------------------
JARVIS_TTS_RATE=178
JARVIS_TTS_VOLUME=1.0
JARVIS_TTS_MAX_CHARS=900
JARVIS_STT_LANGUAGE=en-IN

# ------------------------------------------------------------
# Local runtime state
# Leave blank to use <project>/data/jarvis.db
# ------------------------------------------------------------
# JARVIS_DB_PATH=C:/path/to/jarvis.db

# ------------------------------------------------------------
# File Intelligence
# On Windows separate multiple roots with ';'.
# JARVIS_INDEX_PATHS controls what may be indexed.
# JARVIS_ALLOWED_PATHS is the explicit read-only filesystem sandbox.
# If ALLOWED_PATHS is blank, index roots + the JARVIS project are used.
# ------------------------------------------------------------
# JARVIS_INDEX_PATHS=C:/Users/you/Documents;D:/Projects
# JARVIS_ALLOWED_PATHS=C:/Users/you/Documents;D:/Projects
JARVIS_FILE_MAX_TEXT_BYTES=1000000
JARVIS_EMBED_TEXT_CHARS=6000
JARVIS_EMBED_BATCH_SIZE=24

# Legacy compatibility (optional)
# AI_PROVIDER=openai
# AI_MODEL=gpt-5.6
